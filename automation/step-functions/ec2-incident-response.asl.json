      ],
      "Next": "WorkflowFailed"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Error": "WorkflowFailed",
      "Cause": "A response action or orchestration service integration failed. Inspect the Step Functions execution and DynamoDB execution record."
    },
    "WorkflowInfrastructureFailure": {
      "Type": "Fail",
      "Error": "WorkflowInfrastructureFailure",
      "Cause": "The orchestration execution lock could not be acquired due to an infrastructure error."
    },
    "DuplicateExecution": {
      "Type": "Pass",
      "Parameters": {
        "event_id.$": "$.event_id",
        "incident_id.$": "$.incident_id",
        "mode.$": "$.mode",
        "workflow_status": "DUPLICATE_SKIPPED",
        "operator_note": "This event_id already exists. Use a new event_id only after reviewing the existing execution record."
      },
      "End": true
    },
    "InvalidInput": {
      "Type": "Fail",
      "Error": "InvalidInput",
      "Cause": "Required core fields are missing, mode is unsupported, or dry_run is not a boolean."
    },
    "InvalidRollbackInput": {
      "Type": "Fail",
      "Error": "InvalidRollbackInput",
      "Cause": "Rollback mode requires a rollback_manifest and confirm_restore exactly true."
    }
  }
