    "ValidateRollbackInput": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.rollback_manifest",
              "IsPresent": true
            },
            {
              "Variable": "$.confirm_restore",
              "BooleanEquals": true
            }
          ],
          "Next": "PlanRollback"
        }
      ],
      "Default": "InvalidRollbackInput"
    },
    "PlanRollback": {
      "Type": "Task",
      "Resource": "${restore_ec2_arn}",
      "TimeoutSeconds": 75,
      "Parameters": {
        "incident_id.$": "$.incident_id",
        "expected_account_id.$": "$.expected_account_id",
        "region.$": "$.region",
        "instance_id.$": "$.instance_id",
        "requested_by.$": "$.requested_by",
        "reason.$": "$.reason",
        "rollback_manifest.$": "$.rollback_manifest",
        "confirm_restore": true,
        "dry_run": true
      },
      "ResultPath": "$.results.rollback_plan",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.workflow_error",
          "Next": "RecordWorkflowFailure"
        }
      ],
      "Next": "CheckRollbackDryRun"
    },
    "CheckRollbackDryRun": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.runtime.dry_run",
          "BooleanEquals": true,
          "Next": "NotifyRollbackPlan"
        }
      ],
      "Default": "RequestRollbackApproval"
    },
    "NotifyRollbackPlan": {
      "Type": "Task",
      "Resource": "${notify_incident_arn}",
      "TimeoutSeconds": 75,
      "Parameters": {
        "incident_id.$": "$.incident_id",
        "expected_account_id.$": "$.expected_account_id",
        "region.$": "$.region",
        "requested_by.$": "$.requested_by",
        "reason.$": "$.reason",
        "severity.$": "$.severity",
        "dry_run": true,
        "message.$": "States.Format('Dry-run rollback plan validated for EC2 instance {} in incident {}', $.instance_id, $.incident_id)"
      },
      "ResultPath": "$.results.notification",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.workflow_error",
          "Next": "RecordWorkflowFailure"
        }
      ],
      "Next": "RecordRollbackPlanned"
    },
    "RecordRollbackPlanned": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${execution_table_name}",
        "Key": {
          "event_id": {
            "S.$": "$.event_id"
          }
        },
        "UpdateExpression": "SET #status = :status, updated_at = :updated",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "ROLLBACK_PLANNED"
          },
          ":updated": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.record_error",
          "Next": "RollbackPlanned"
        }
      ],
      "Next": "RollbackPlanned"
    },
    "RollbackPlanned": {
      "Type": "Pass",
      "Parameters": {
        "event_id.$": "$.event_id",
        "incident_id.$": "$.incident_id",
        "mode": "rollback",
        "workflow_status": "PLANNED",
        "dry_run": true,
        "rollback_plan.$": "$.results.rollback_plan",
        "notification.$": "$.results.notification"
      },
      "End": true
    },
    "RequestRollbackApproval": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::sns:publish.waitForTaskToken",
      "TimeoutSeconds": "__APPROVAL_TIMEOUT_SECONDS__",
      "Parameters": {
        "TopicArn": "${approval_topic_arn}",
        "Subject": "[APPROVAL REQUIRED] AWS incident rollback",
        "Message": {
          "approval_type": "rollback",
          "task_token.$": "$$.Task.Token",
          "event_id.$": "$.event_id",
          "incident_id.$": "$.incident_id",
          "severity.$": "$.severity",
          "instance_id.$": "$.instance_id",
          "account_id.$": "$.expected_account_id",
          "region.$": "$.region",
          "requested_by.$": "$.requested_by",
          "reason.$": "$.reason",
          "execution_arn.$": "$$.Execution.Id",
          "instruction": "Return the task token with SendTaskSuccess and a JSON decision of APPROVE or DENY. Treat the token as a secret."
        }
      },
      "ResultPath": "$.approval",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.workflow_error",
          "Next": "RecordRollbackApprovalTimeout"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.workflow_error",
          "Next": "RecordWorkflowFailure"
        }
      ],
      "Next": "EvaluateRollbackApproval"
    },
    "EvaluateRollbackApproval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.approval.decision",
          "StringEquals": "APPROVE",
          "Next": "ExecuteRollbackLive"
        },
        {
          "Variable": "$.approval.decision",
          "StringEquals": "DENY",
          "Next": "RecordRollbackDenied"
        }
      ],
      "Default": "RecordRollbackInvalidApproval"
    },
    "ExecuteRollbackLive": {
      "Type": "Task",
      "Resource": "${restore_ec2_arn}",
      "TimeoutSeconds": 75,
      "Parameters": {
        "incident_id.$": "$.incident_id",
        "expected_account_id.$": "$.expected_account_id",
        "region.$": "$.region",
        "instance_id.$": "$.instance_id",
        "requested_by.$": "$.requested_by",
        "reason.$": "$.reason",
        "rollback_manifest.$": "$.rollback_manifest",
        "confirm_restore": true,
        "dry_run": false
      },
      "ResultPath": "$.results.rollback",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.workflow_error",
          "Next": "RecordRollbackPartialFailure"
        }
      ],
      "Next": "NotifyRollbackSuccess"
    },
    "NotifyRollbackSuccess": {
      "Type": "Task",
      "Resource": "${notify_incident_arn}",
      "TimeoutSeconds": 75,
      "Parameters": {
        "incident_id.$": "$.incident_id",
        "expected_account_id.$": "$.expected_account_id",
        "region.$": "$.region",
        "requested_by.$": "$.requested_by",
        "reason.$": "$.reason",
        "severity.$": "$.severity",
        "dry_run": false,
        "message.$": "States.Format('Approved EC2 network rollback completed for instance {} in incident {}', $.instance_id, $.incident_id)"
      },
      "ResultPath": "$.results.notification",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.workflow_error",
          "Next": "RecordRollbackPartialFailure"
        }
      ],
      "Next": "RecordRollbackSuccess"
    },
    "RecordRollbackSuccess": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${execution_table_name}",
        "Key": {
          "event_id": {
            "S.$": "$.event_id"
          }
        },
        "UpdateExpression": "SET #status = :status, updated_at = :updated",
        "ExpressionAttributeNames": {
