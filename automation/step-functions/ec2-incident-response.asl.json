        "ExpressionAttributeValues": {
          ":status": {
            "S": "ROLLBACK_COMPLETED"
          },
          ":updated": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.record_error",
          "Next": "RollbackSucceeded"
        }
      ],
      "Next": "RollbackSucceeded"
    },
    "RollbackSucceeded": {
      "Type": "Pass",
      "Parameters": {
        "event_id.$": "$.event_id",
        "incident_id.$": "$.incident_id",
        "mode": "rollback",
        "workflow_status": "SUCCEEDED",
        "dry_run": false,
        "approval.$": "$.approval",
        "rollback_plan.$": "$.results.rollback_plan",
        "rollback.$": "$.results.rollback",
        "notification.$": "$.results.notification"
      },
      "End": true
    },
