    "RecordWorkflowFailure": {
      "Type": "Task",
      "Resource": "arn:${partition}:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${execution_table_name}",
        "Key": {
          "event_id": {
            "S.$": "$.event_id"
          }
        },
        "UpdateExpression": "SET #status = :status, updated_at = :updated, last_error = :error, last_cause = :cause",
