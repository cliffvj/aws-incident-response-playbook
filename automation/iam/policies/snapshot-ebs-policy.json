{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInstanceAndExistingIncidentSnapshots",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSnapshots"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateAndTagEvidenceSnapshots",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    }
  ]
}
