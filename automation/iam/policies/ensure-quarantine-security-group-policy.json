{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:DescribeSecurityGroups",
      "Resource": "*"
    },
    {
      "Sid": "CreateAndTagQuarantineGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "aws-ir-playbook"
        }
      }
    },
    {
      "Sid": "RemoveRulesFromManagedQuarantineGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:*:111122223333:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "aws-ir-playbook"
        }
      }
    }
  ]
}
