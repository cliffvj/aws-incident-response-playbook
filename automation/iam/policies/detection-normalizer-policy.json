{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Deduplicate",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/PROJECT-detection-dedup"
    },
    {
      "Sid": "StartTriage",
      "Effect": "Allow",
      "Action": [
        "states:StartExecution"
      ],
      "Resource": "arn:aws:states:REGION:ACCOUNT_ID:stateMachine:PROJECT-ec2-incident-response"
    },
    {
      "Sid": "Notify",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:REGION:ACCOUNT_ID:PROJECT-notifications"
    }
  ]
}
