{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAccessKeyLastUsed",
      "Effect": "Allow",
      "Action": "iam:GetAccessKeyLastUsed",
      "Resource": "*"
    },
    {
      "Sid": "InspectAndDisableNamedUserKeys",
      "Effect": "Allow",
      "Action": [
        "iam:ListAccessKeys",
        "iam:UpdateAccessKey"
      ],
      "Resource": "arn:aws:iam::111122223333:user/incident-lab/*"
    }
  ]
}
