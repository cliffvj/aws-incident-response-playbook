{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAndContainBucketPublicAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::example-incident-bucket-123"
    }
  ]
}
