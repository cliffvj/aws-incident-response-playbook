# Copy to backend.tf and replace placeholders before terraform init -migrate-state.
# Backend blocks cannot use normal Terraform input variables.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
    key          = "aws-ir/platform/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
