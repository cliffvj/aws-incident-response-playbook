deployment_environment = "lab"
permissions_boundary_arn = null
kms_deletion_window_days = 7
aws_region             = "us-east-1"
project_name           = "aws-ir-lab"
log_retention_days     = 30
lambda_timeout_seconds = 60
lambda_memory_mb       = 256

s3_bucket_arns = [
  "arn:aws:s3:::replace-with-authorized-lab-bucket"
]

iam_user_arns = [
  "arn:aws:iam::111122223333:user/incident-lab/*"
]

tags = {
  Environment = "Lab"
  Owner       = "SecurityEngineering"
}

# Human approval controls. Keep execution data logging disabled because callback
# task tokens and incident context can be sensitive.
approval_timeout_seconds              = 3600
step_functions_include_execution_data = false

# Optional lab-only email subscription. Leave null unless the mailbox is an
# explicitly authorized approval channel and you understand that task tokens
# will be delivered there.
approval_email_endpoint = null

# Systems Manager investigation evidence. Leave bucket name null to derive a
# globally unique lab name from project/account/Region. Adjust retention to your
# authorized evidence policy before deploying outside a disposable lab.
ssm_evidence_bucket_name               = null
ssm_evidence_retention_days            = 90
ssm_evidence_noncurrent_retention_days = 30

# Detection-to-response defaults remain conservative.
detection_default_route = "notify_only"
enable_cloudwatch_alarm_routing = false
enable_detection_event_archive = false
# detection_allowed_account_ids = ["111122223333"]
# detection_ignore_principal_arn_prefixes = ["arn:aws:sts::111122223333:assumed-role/aws-ir-lab-"]
# cloudwatch_security_log_group_name = "/aws/lambda/example"
